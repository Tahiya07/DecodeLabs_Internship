```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Next.js
.next/
out/

# Production
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Capacitor / Android
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/.cxx/
android/captures/
android/local.properties
android/*.iml
android/app/*.iml

# Android generated files
*.apk
*.aab
*.apks

# Gradle
.gradle/
**/build/

# Signing / keystore files
*.keystore
*.jks
*.p12

# Xcode / iOS (if added later)
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/

# Capacitor generated sync files
# Keep android/ and ios/ source projects committed.
# Only ignore generated build artifacts.

# Cache
.cache/
.parcel-cache/
.turbo/
.eslintcache/

# Coverage
coverage/

# Temporary files
tmp/
temp/
*.tmp
*.bak
```
